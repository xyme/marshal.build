# marshal backend configuration (copy to backend/.env for local dev).
# Cloud deployments receive these through the ECS task definition instead —
# see infra/lib/app-stack.ts and scripts/sync-env.sh.

AWS_REGION=us-east-1
ENVIRONMENT=dev                       # dev | cloud (cloud fails security-closed)

# Cognito (from the MarshalAuthStack outputs after your first deploy;
# scripts/sync-env.sh fills these for you)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Postgres — matches docker-compose.yml for local dev
DATABASE_URL=postgresql+asyncpg://marshal:marshal@localhost:5432/marshal

# DynamoDB chat store (created by MarshalDataStack)
DYNAMO_TABLE_CHAT=marshal-chat-messages

# Bedrock models (your account needs model access granted in the console)
BEDROCK_MODEL_CHAT=us.anthropic.claude-sonnet-5
BEDROCK_MODEL_SPEC=us.anthropic.claude-sonnet-5
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Deployment provider: direct (deploy agents into THIS account) is the
# generic default; isb requires an AWS Innovation Sandbox hub installation.
SANDBOX_PROVIDER=direct
# Direct mode in the cloud assumes the scoped MarshalDirectDeployRole that
# MarshalAppStack creates (set automatically on the ECS task). Leave empty
# locally to deploy with your ambient credentials.
DIRECT_DEPLOY_ROLE_ARN=
ISB_API_BASE_URL=
ISB_BLUEPRINT_ID=

# Codegen workspace (created by MarshalBuildStack; needed for cdk-app builds)
CODEGEN_WORKSPACE_BUCKET=

SAMPLE_APP_TEMPLATE_PATH=../sample-app/template.json
# Public URL used in notification / webhook / chat-ops deep links (the cloud
# task derives it from the CloudFront URL or APP_DOMAIN).
APP_BASE_URL=http://localhost:3000
# E-mail channel (dark until SES production access): sender identity.
EMAIL_ENABLED=false
EMAIL_FROM=marshal <no-reply@localhost>
