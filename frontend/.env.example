# marshal frontend configuration (copy to frontend/.env.local for local dev).
# scripts/sync-env.sh generates this from your deployed stacks.

# Auth.js session encryption secret — any long random string
AUTH_SECRET=

# Cognito hosted-UI OAuth client (MarshalAuthStack outputs; the client
# secret comes from `aws cognito-idp describe-user-pool-client`)
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>
COGNITO_DOMAIN=https://<your-prefix>.auth.<region>.amazoncognito.com

# FastAPI backend
BACKEND_URL=http://localhost:8000

# Build-time public values (inlined into the client bundle)
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Optional support contact shown on the profile page (block hidden when the
# e-mail is empty). Hours are free text, e.g. "Weekdays 09:00–17:00 UTC".
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=

AUTH_TRUST_HOST=true
